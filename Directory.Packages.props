<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Platform-managed internal packages -->
    <PackageVersion Include="LagoVista.Core" Version="5.0.0" />
    <PackageVersion Include="LagoVista.Core.Configuration" Version="5.0.0" />

    <!-- Repository-managed external packages -->
    <PackageVersion Include="OpenTelemetry" Version="1.12.0" />
    <PackageVersion Include="log4net" Version="3.2.0" />
    <PackageVersion Include="NLog" Version="6.0.4" />
  </ItemGroup>
</Project>
