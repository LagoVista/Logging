<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="nuviot" value="https://nuget.pkg.github.com/nuviot/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuviot">
      <package pattern="LagoVista.*" />
      <package pattern="NuvIoT.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="OpenTelemetry*" />
      <package pattern="log4net" />
      <package pattern="NLog" />
      <package pattern="Moq" />
      <package pattern="Microsoft.*" />
      <package pattern="MSTest.*" />
      <package pattern="NLipsum" />
      <package pattern="NUnit*" />
      <package pattern="coverlet.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
